# Universal Agents settings. Copy to .env and fill in. Never commit .env.
# Every setting can also be an environment variable (environment variables win).

# --- Required -----------------------------------------------------------------
# Random secret mixed into every key hash. Make one with: agents generate-secret
# Changing it later makes every existing key invalid.
AGENTS_KEY_PEPPER=REPLACE_WITH_THE_OUTPUT_OF_agents_generate-secret

# --- Docker compose (docs/deploying.md) -------------------------------------------
# compose sets the database address, AGENTS_DATA_DIR and the model address itself.
# PostgreSQL password inside the compose network. Make one with: agents generate-secret
POSTGRES_PASSWORD=
# The API's public name for HTTPS (its DNS record points at the server), e.g. agents.example.com
AGENTS_DOMAIN=
# The API's port on the server (127.0.0.1 only; nginx or Caddy forwards to it)
AGENTS_API_PORT=8000
# API processes and worker containers
AGENTS_API_PROCESSES=2
AGENTS_WORKERS=1
# The model as the containers see it. Empty: Ollama in compose (--profile ollama).
# Laptop with Ollama on Windows: http://host.docker.internal:11434/v1
AGENTS_DOCKER_MODEL_URL=

# --- Database and files ---------------------------------------------------------
# Laptop: SQLite file. Server: postgresql+psycopg://user:password@host:5432/agents
AGENTS_DATABASE_URL=sqlite:///data/agents.db
AGENTS_DATA_DIR=data
# local (files under AGENTS_DATA_DIR/files) or s3
AGENTS_STORAGE=local
AGENTS_S3_BUCKET=
AGENTS_S3_PREFIX=uploads/
AGENTS_S3_REGION=
# Only for S3-compatible test servers:
AGENTS_S3_ENDPOINT_URL=

# --- Agents -----------------------------------------------------------------------
AGENTS_ENABLED_AGENTS=cv,linkedin
# Lookup agents (docs/lookup-agents.md): add nppes, oig, sam to the line above.
# LinkedIn screenshots per job (1-10)
AGENTS_LINKEDIN_MAX_FILES=5

# --- Model (default: Qwen on Ollama on this machine) ---------------------------------
# ollama / openai: any OpenAI-compatible server (Ollama, vLLM, hosted). anthropic: API key.
AGENTS_MODEL_PROVIDER=ollama
AGENTS_MODEL_BASE_URL=http://127.0.0.1:11434/v1
AGENTS_MODEL_NAME=kormic-local
AGENTS_MODEL_API_KEY=
AGENTS_MODEL_STRUCTURED_MODE=json_schema
AGENTS_MODEL_REASONING_EFFORT=none
# Must equal the model's num_ctx
AGENTS_MODEL_CONTEXT_TOKENS=16384
AGENTS_MODEL_OUTPUT_TOKENS=2048
AGENTS_MODEL_REQUEST_SECONDS=120
# Plain HTTP to a model on another machine (private networks only)
AGENTS_MODEL_ALLOW_HTTP=false
# Speed on CPU: text before the question so Ollama can reuse it (false = Kormic's earlier layout)
AGENTS_MODEL_TEXT_FIRST=true
# Per-agent model, for example {"linkedin": {"provider": "anthropic", "name": "...", "api_key": "..."}}
# (a different provider or server needs its own api_key and gets its own default limits)
AGENTS_MODEL_OVERRIDES={}

# --- Lookup agents' own settings (only when switched on) ---------------------------
# Outside calls over IPv4 (true). Set false only on a network that has IPv6 and no IPv4.
# AGENTS_OUTBOUND_IPV4=true
# AGENTS_NPPES_TIMEOUT_SECONDS=15
# AGENTS_NPPES_CACHE_HOURS=24
# OIG: load the list with: agents tool oig load --file UPDATED.csv --as-of YYYY-MM-DD
# AGENTS_OIG_MAX_AGE_DAYS=45
# SAM: a SAM.gov API key is required. A free key allows 10 calls a day.
# AGENTS_SAM_API_KEY=
# AGENTS_SAM_TIMEOUT_SECONDS=60
# AGENTS_SAM_DAILY_LIMIT=10
# AGENTS_SAM_CACHE_HOURS=24
# AGENTS_SAM_MAX_PAGES=5
# AGENTS_SAM_PROJECT_DAILY_LIMIT=
# AGENTS_SAM_MAPPING_VERIFIED=false
# GitHub: works without a token (60 calls an hour); a token with no scopes allows 5,000.
# AGENTS_GITHUB_TOKEN=
# AGENTS_GITHUB_DAILY_LIMIT=4000
# AGENTS_GITHUB_CACHE_HOURS=24
# AGENTS_GITHUB_MAX_REPOS=100

# --- Reading ----------------------------------------------------------------------
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe   (Linux: leave empty)
AGENTS_TESSERACT_CMD=

# --- Debugging a reader (test machines only) ------------------------------------------
# A folder: every model question and answer is saved there, one JSON file each, in a
# subfolder per job. The files hold the documents' text: never set it in production.
# AGENTS_DEBUG_DIR=D:\agents-debug
# Read each file in a separate limited process (recommended)
AGENTS_ISOLATE_PARSING=true
# Longest time to read one file, and longest model time for one file
AGENTS_FILE_SECONDS=900
# CV text piece size (1800 = Kormic's earlier behaviour; bigger = fewer model questions)
AGENTS_CV_CHUNK_CHARS=3000

# --- Limits -----------------------------------------------------------------------
AGENTS_REQUESTS_PER_MINUTE=60
AGENTS_READS_PER_MINUTE=600
AGENTS_JOBS_PER_MINUTE=10
AGENTS_MAX_WAITING_PER_PROJECT=50
AGENTS_MAX_WAITING_TOTAL=500

# --- Job line -----------------------------------------------------------------------
AGENTS_LEASE_SECONDS=120
AGENTS_MAX_ATTEMPTS=2
AGENTS_QUEUE_EXPIRY_SECONDS=1800
AGENTS_RESULT_RETENTION_SECONDS=604800
AGENTS_POLL_SECONDS=2
